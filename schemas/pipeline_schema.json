{
  "$defs": {
    "BackgroundFillTransform": {
      "description": "Fills the transparent background with a solid color.\n\nThe algorithm uses alpha blending to composite the existing image over\na solid background color. If no color is provided, a random bright\ncolor is generated.",
      "properties": {
        "name": {
          "default": "BackgroundFillTransform",
          "enum": [
            "background_fill_transform",
            "BackgroundFillTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "BackgroundFillTransform",
      "type": "object"
    },
    "BrightnessContrastTransform": {
      "description": "Adjusts the brightness and contrast of the image.\n\nThe algorithm uses linear scaling applied only to the RGB channels\nwhile maintaining the original alpha channel.",
      "properties": {
        "name": {
          "default": "BrightnessContrastTransform",
          "enum": [
            "brightness_contrast_transform",
            "BrightnessContrastTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "brightness": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.0,
          "title": "Brightness"
        },
        "contrast": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 1.0,
          "title": "Contrast"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "BrightnessContrastTransform",
      "type": "object"
    },
    "CircleTransform": {
      "description": "Draws a hand-drawn circle or ellipse around a text line.\n\nThe algorithm selects a random text line and draws multiple overlapping,\nslightly jittered arcs in blue ink.",
      "properties": {
        "name": {
          "default": "CircleTransform",
          "enum": [
            "circle_transform",
            "CircleTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "probability": {
          "default": 0.4,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "CircleTransform",
      "type": "object"
    },
    "CrushedDocumentTransform": {
      "description": "Simulates a crushed or folded document.\n\nThe algorithm applies a coarse elastic deformation using Cubic\ninterpolation remapping and adds random linear fold lines to the RGB\nchannels by adjusting pixel intensity along sampled vectors.",
      "properties": {
        "name": {
          "default": "CrushedDocumentTransform",
          "enum": [
            "crushed_document_transform",
            "CrushedDocumentTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "distortion_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.03,
          "title": "Distortion Scale"
        },
        "num_folds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 8,
          "title": "Num Folds"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "CrushedDocumentTransform",
      "type": "object"
    },
    "CylindricalTransform": {
      "description": "Simulates paper curvature or cylindrical wrapping.\n\nThe algorithm applies a parabolic vertical mapping to simulate the\nwarping of paper when held or placed on a curved surface. Bounding\nboxes are adjusted and fitted with minimum area rectangles to maintain\nstructural integrity.",
      "properties": {
        "name": {
          "default": "CylindricalTransform",
          "enum": [
            "cylindrical_transform",
            "CylindricalTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "curvature": {
          "default": 0.0001,
          "title": "Curvature",
          "type": "number"
        },
        "probability": {
          "default": 0.5,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "CylindricalTransform",
      "type": "object"
    },
    "DilationTransform": {
      "description": "Applies morphological dilation to the image.\n\nThe algorithm uses a square kernel of a sampled size to expand\nthe brighter regions in the image.",
      "properties": {
        "name": {
          "default": "DilationTransform",
          "enum": [
            "dilation_transform",
            "DilationTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "kernel_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 3,
          "title": "Kernel Size"
        },
        "iterations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 1,
          "title": "Iterations"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "DilationTransform",
      "type": "object"
    },
    "ErosionTransform": {
      "description": "Applies morphological erosion to the image.\n\nThe algorithm uses a square kernel of a sampled size to shrink\nthe brighter regions in the image.",
      "properties": {
        "name": {
          "default": "ErosionTransform",
          "enum": [
            "erosion_transform",
            "ErosionTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "kernel_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 3,
          "title": "Kernel Size"
        },
        "iterations": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 1,
          "title": "Iterations"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "ErosionTransform",
      "type": "object"
    },
    "FontConfig": {
      "description": "Configuration for a single font.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "priority": {
          "default": 1.0,
          "title": "Priority",
          "type": "number"
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "FontConfig",
      "type": "object"
    },
    "GaussianNoiseTransform": {
      "description": "Adds random Gaussian noise to the image.\n\nThe algorithm generates noise from a normal distribution and adds it\nexclusively to the RGB channels, preserving the alpha channel.",
      "properties": {
        "name": {
          "default": "GaussianNoiseTransform",
          "enum": [
            "gaussian_noise_transform",
            "GaussianNoiseTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "sigma": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "Sigma"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "sigma"
      ],
      "title": "GaussianNoiseTransform",
      "type": "object"
    },
    "HandwritingTransform": {
      "description": "Simulates handwritten notes or marks on the document.\n\nThe algorithm uses Pillow to draw randomly selected text with a\nhandwriting font at a random position.",
      "properties": {
        "name": {
          "default": "HandwritingTransform",
          "enum": [
            "handwriting_transform",
            "HandwritingTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "font_path": {
          "title": "Font Path",
          "type": "string"
        },
        "texts": {
          "items": {
            "type": "string"
          },
          "title": "Texts",
          "type": "array"
        },
        "probability": {
          "default": 0.3,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "font_path"
      ],
      "title": "HandwritingTransform",
      "type": "object"
    },
    "HuggingFaceBackgroundTransform": {
      "description": "Adds a random background image from a Hugging Face dataset.\n\nThe algorithm loads a dataset from Hugging Face, selects a random\nimage from it, resizes and crops it to match the sample dimensions,\nand alpha-composites the sample onto it.",
      "properties": {
        "name": {
          "default": "HuggingFaceBackgroundTransform",
          "enum": [
            "hugging_face_background_transform",
            "HuggingFaceBackgroundTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "dataset_name": {
          "title": "Dataset Name",
          "type": "string"
        },
        "split": {
          "default": "train",
          "title": "Split",
          "type": "string"
        },
        "image_column": {
          "default": "image",
          "title": "Image Column",
          "type": "string"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "kwargs": {
          "additionalProperties": true,
          "title": "Kwargs",
          "type": "object"
        }
      },
      "required": [
        "dataset_name"
      ],
      "title": "HuggingFaceBackgroundTransform",
      "type": "object"
    },
    "MixBatchTransform": {
      "description": "Generates synthetic samples by mixing text lines from multiple sources.\n\nThe algorithm selects a subset of samples from the batch, extracts their\ntext lines using polygon masks, and places them onto a new transparent\ncanvas. It ensures no overlaps between placed elements and uses alpha\ncompositing for realistic blending.",
      "properties": {
        "name": {
          "default": "MixBatchTransform",
          "enum": [
            "mix_batch_transform",
            "MixBatchTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "m": {
          "title": "M",
          "type": "integer"
        },
        "k": {
          "title": "K",
          "type": "integer"
        },
        "min_lines": {
          "default": 10,
          "title": "Min Lines",
          "type": "integer"
        },
        "max_lines": {
          "default": 20,
          "title": "Max Lines",
          "type": "integer"
        },
        "margin": {
          "default": 5,
          "title": "Margin",
          "type": "integer"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "m",
        "k"
      ],
      "title": "MixBatchTransform",
      "type": "object"
    },
    "MotionBlurTransform": {
      "description": "Applies a horizontal or vertical motion blur.\n\nThe algorithm creates a 1D kernel oriented randomly and applies it\nusing a 2D filter to simulate movement blur.",
      "properties": {
        "name": {
          "default": "MotionBlurTransform",
          "enum": [
            "motion_blur_transform",
            "MotionBlurTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "kernel_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          ],
          "default": 5,
          "title": "Kernel Size"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "MotionBlurTransform",
      "type": "object"
    },
    "PerspectiveTransform": {
      "description": "Applies random perspective distortion.\n\nThe algorithm maps the corners of the image to new random positions\nwithin a defined distortion scale and applies the resulting perspective\nmatrix to both the image and the text line bounding boxes.",
      "properties": {
        "name": {
          "default": "PerspectiveTransform",
          "enum": [
            "perspective_transform",
            "PerspectiveTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "distortion_scale": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.2,
          "title": "Distortion Scale"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "PerspectiveTransform",
      "type": "object"
    },
    "RandomImageBackgroundTransform": {
      "description": "Adds a random background image from a directory.\n\nThe algorithm selects a random image from the specified directory,\nresizes and crops it to match the sample dimensions, and alpha-composites\nthe sample onto it.",
      "properties": {
        "name": {
          "default": "RandomImageBackgroundTransform",
          "enum": [
            "random_image_background_transform",
            "RandomImageBackgroundTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "image_dir": {
          "title": "Image Dir",
          "type": "string"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "image_dir"
      ],
      "title": "RandomImageBackgroundTransform",
      "type": "object"
    },
    "RotationTransform": {
      "description": "Applies random rotation to samples.\n\nThe algorithm computes a rotation matrix based on a sampled angle and\napplies it to both the image (using affine warping with transparent\nborders) and the bounding box coordinates.",
      "properties": {
        "name": {
          "default": "RotationTransform",
          "enum": [
            "rotation_transform",
            "RotationTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "max_angle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "Max Angle"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "max_angle"
      ],
      "title": "RotationTransform",
      "type": "object"
    },
    "SaltAndPepperNoiseTransform": {
      "description": "Adds salt and pepper (impulse) noise.\n\nThe algorithm randomly sets pixels to either full white or full black\nbased on the specified amount and distribution ratio.",
      "properties": {
        "name": {
          "default": "SaltAndPepperNoiseTransform",
          "enum": [
            "salt_and_pepper_noise_transform",
            "SaltAndPepperNoiseTransform"
          ],
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.01,
          "title": "Amount"
        },
        "salt_vs_pepper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "default": 0.5,
          "title": "Salt Vs Pepper"
        },
        "probability": {
          "default": 1.0,
          "title": "Probability",
          "type": "number"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "title": "SaltAndPepperNoiseTransform",
      "type": "object"
    },
    "SampleTransformPipeline": {
      "description": "Sequential execution of image transformations.",
      "properties": {
        "transforms": {
          "items": {
            "discriminator": {
              "mapping": {
                "BackgroundFillTransform": "#/$defs/BackgroundFillTransform",
                "BrightnessContrastTransform": "#/$defs/BrightnessContrastTransform",
                "CircleTransform": "#/$defs/CircleTransform",
                "CrushedDocumentTransform": "#/$defs/CrushedDocumentTransform",
                "CylindricalTransform": "#/$defs/CylindricalTransform",
                "DilationTransform": "#/$defs/DilationTransform",
                "ErosionTransform": "#/$defs/ErosionTransform",
                "GaussianNoiseTransform": "#/$defs/GaussianNoiseTransform",
                "HandwritingTransform": "#/$defs/HandwritingTransform",
                "HuggingFaceBackgroundTransform": "#/$defs/HuggingFaceBackgroundTransform",
                "MixBatchTransform": "#/$defs/MixBatchTransform",
                "MotionBlurTransform": "#/$defs/MotionBlurTransform",
                "PerspectiveTransform": "#/$defs/PerspectiveTransform",
                "RandomImageBackgroundTransform": "#/$defs/RandomImageBackgroundTransform",
                "RotationTransform": "#/$defs/RotationTransform",
                "SaltAndPepperNoiseTransform": "#/$defs/SaltAndPepperNoiseTransform",
                "ShadowLightingTransform": "#/$defs/ShadowLightingTransform",
                "ShearTransform": "#/$defs/ShearTransform",
                "StampTransform": "#/$defs/StampTransform",
                "TextureBackgroundTransform": "#/$defs/TextureBackgroundTransform",
                "WaveTransform": "#/$defs/WaveTransform",
                "background_fill_transform": "#/$defs/BackgroundFillTransform",
                "brightness_contrast_transform": "#/$defs/BrightnessContrastTransform",
                "circle_transform": "#/$defs/CircleTransform",
                "crushed_document_transform": "#/$defs/CrushedDocumentTransform",
                "cylindrical_transform": "#/$defs/CylindricalTransform",
                "dilation_transform": "#/$defs/DilationTransform",
                "erosion_transform": "#/$defs/ErosionTransform",
                "gaussian_noise_transform": "#/$defs/GaussianNoiseTransform",
                "handwriting_transform": "#/$defs/HandwritingTransform",
                "hugging_face_background_transform": "#/$defs/HuggingFaceBackgroundTransform",
                "mix_batch_transform": "#/$defs/MixBatchTransform",
                "motion_blur_transform": "#/$defs/MotionBlurTransform",
                "perspective_transform": "#/$defs/PerspectiveTransform",
                "random_image_background_transform": "#/$defs/RandomImageBackgroundTransform",
                "rotation_transform": "#/$defs/RotationTransform",
                "salt_and_pepper_noise_transform": "#/$defs/SaltAndPepperNoiseTransform",
                "shadow_lighting_transform": "#/$defs/ShadowLightingTransform",
                "shear_transform": "#/$defs/ShearTransform",
                "stamp_transform": "#/$defs/StampTransform",
                "texture_background_transform": "#/$defs/TextureBackgroundTransform",
                "wave_transform": "#/$defs/WaveTransform"
              },
              "propertyName": "name"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BackgroundFillTransform"
              },
              {
                "$ref": "#/$defs/HuggingFaceBackgroundTransform"
              },
              {
                "$ref": "#/$defs/RandomImageBackgroundTransform"
              },
              {
                "$ref": "#/$defs/ShadowLightingTransform"
              },
              {
                "$ref": "#/$defs/TextureBackgroundTransform"
              },
              {
                "$ref": "#/$defs/CrushedDocumentTransform"
              },
              {
                "$ref": "#/$defs/CylindricalTransform"
              },
              {
                "$ref": "#/$defs/PerspectiveTransform"
              },
              {
                "$ref": "#/$defs/RotationTransform"
              },
              {
                "$ref": "#/$defs/ShearTransform"
              },
              {
                "$ref": "#/$defs/WaveTransform"
              },
              {
                "$ref": "#/$defs/BrightnessContrastTransform"
              },
              {
                "$ref": "#/$defs/CircleTransform"
              },
              {
                "$ref": "#/$defs/DilationTransform"
              },
              {
                "$ref": "#/$defs/ErosionTransform"
              },
              {
                "$ref": "#/$defs/GaussianNoiseTransform"
